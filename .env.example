# zmzai 客户端桥接配置
# 云端桥接端点（Agent 经此下发明文工具请求）。本地自测可用 pnpm mock-bridge 启动的 wss://localhost:8787
BRIDGE_URL=wss://b.zmzai.cloud/bridge

# 本机在该端点注册的身份（由云端签发）
CLIENT_ID=local-dev-client
CLIENT_SECRET=change-me-in-production

# 本地能力开关
# 允许云端读写的目录根（逗号分隔，相对 ~ 或绝对路径）。默认仅沙箱工作区。
APPROVED_ROOTS=~/zmzai-client/workspace
# 是否允许 shell.exec（默认关闭，开启后仍需逐条审批）
SHELL_ENABLED=false
# 单次命令/文件操作超时（毫秒）
EXEC_TIMEOUT_MS=30000
