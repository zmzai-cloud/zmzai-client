# zmzai 客户端桥接配置
# 云端桥接端点（Agent 经此下发明文工具请求）。本地自测可用 pnpm mock-bridge 启动的 wss://localhost:8787
BRIDGE_URL=wss://b.zmzai.cloud/bridge

# 本机在该端点注册的身份（由云端签发）
CLIENT_ID=local-dev-client
CLIENT_SECRET=change-me-in-production

# 本机归属的用户标识（hello 携带、被签名覆盖）——云端据此把 Agent 请求路由到本机
USER_ID=local-dev-user

# 云端桥接端点的公钥 PEM（验 welcome 签名，防伪造云端端点）。生产必须配置；
# 由云端执行 `node scripts/generate-keypair.mjs` 生成，多行时用 \n 转义。
# 未配置时跳过验签（仅限本机联调）。
# BRIDGE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# 是否允许非 wss 连接（默认 false；仅本机连 mock 联调时设 true，生产必须 wss）
ALLOW_INSECURE_WS=false
# 审批弹窗超时（毫秒），超时默认拒绝执行
APPROVAL_TIMEOUT_MS=120000

# 本地能力开关
# 允许云端读写的目录根（逗号分隔，相对 ~ 或绝对路径）。默认仅沙箱工作区。
APPROVED_ROOTS=~/zmzai-client/workspace
# 是否允许 shell.exec（默认关闭，开启后仍需逐条审批）
SHELL_ENABLED=false
# 单次命令/文件操作超时（毫秒）
EXEC_TIMEOUT_MS=30000
