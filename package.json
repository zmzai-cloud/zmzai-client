{
  "name": "zmzai-client",
  "version": "0.1.0",
  "private": true,
  "description": "zmzai 客户端 — 云端 Agent 的本地伴侣 / 桥接器（Electron）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS= electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock": "node scripts/mock-bridge.mjs",
    "dev:mock": "node scripts/mock-bridge.mjs & NODE_OPTIONS= electron-vite dev",
    "e2e:build": "esbuild e2e/harness.ts --bundle --platform=node --format=esm --external:electron --external:ws --external:zod --outfile=e2e/harness.mjs",
    "e2e": "pnpm build && pnpm e2e:build && NODE_OPTIONS= electron e2e/harness.mjs",
    "e2e:node": "esbuild e2e/pilot.ts --bundle --platform=node --format=esm --external:ws --external:zod --outfile=e2e/pilot.mjs && node e2e/pilot.mjs"
  },
  "dependencies": {
    "@zmzai/bridge-protocol": "file:../zmzai-bridge-protocol",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.21.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
